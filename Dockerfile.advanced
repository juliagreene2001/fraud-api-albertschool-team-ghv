# syntax=docker/dockerfile:1
# Advanced variant: distroless runtime image (no shell or apt), with uv build caching.
#   docker build -f Dockerfile.advanced --platform linux/amd64 -t fraud-api:advanced .

# ---- Stage 1: build — same Debian and Python (3.13) as the runtime image
FROM debian:trixie-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 libgomp1 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/bin/python3 \
    UV_PYTHON_DOWNLOADS=never
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --locked --no-default-groups --no-install-project \
      --no-install-package nvidia-nccl-cu13

# ---- Stage 2: runtime — distroless, no shell or apt, running as nonroot
FROM gcr.io/distroless/python3-debian13:nonroot AS runtime
WORKDIR /app
# OpenMP for XGBoost: no apt here, so copy the library from the build stage
COPY --from=build /usr/lib/*-linux-gnu/libgomp.so.1 /usr/lib/
COPY --from=build /app/.venv /app/.venv
COPY models/model.ubj models/features.json ./models/
COPY app.py features.py scoring.py settings.py ./
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/app/data \
    WEB_CONCURRENCY=1 XGB_NTHREAD=1
USER nonroot
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --retries=3 \
  CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=2)"]
ENTRYPOINT ["/app/.venv/bin/python", "-m", "uvicorn"]
CMD ["app:app", "--host", "0.0.0.0", "--port", "8000"]
